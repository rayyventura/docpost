# Service ports
AUTH_PORT=3001
PLATFORM_PORT=3002
DOCPOST_API_PORT=3003

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/docpost

# AWS (for workers)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# SQS
SQS_FANOUT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/fanout
SQS_DELIVERY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/delivery

# S3
S3_BUCKET_NAME=docpost-documents

# JWT
JWT_SECRET=your-jwt-secret

# Auth calls this when a new account is added to every team.
# More granular permission access will be provided on demand in v2.
PLATFORM_URL=http://localhost:3002

# Password reset email
# When SMTP_HOST is unset and NODE_ENV is not production, the reset link is logged instead of sent.
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DocPost <noreply@localhost>
